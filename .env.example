# Product Application Configuration
APP_ENV=local
APP_DEBUG=true
BASE_URL=http://localhost/bmc_barros/public
ACTIVE_CLIENT=bmc
# env = tenant fixo pelo .env | domain = resolve pelo HTTP Host (ver config/tenants.php)
TENANT_RESOLUTION=env


# Database Configuration
DB_HOST=localhost
DB_NAME=erp_product
DB_USER=root
DB_PASS=

# Multi-tenant database-per-tenant (Fase 2 — default desligado; produção permanece legado)
MULTITENANT_DB=false
MASTER_DB_NAME=erp_master
# Setup mestre (dev): php migrate_master.php run && php migrate_master.php seed
# Onboarding tenant: php tenant.php tenant:create {slug} --domain=host --admin-email=... --admin-password=...
# Dev com cutover (Fase 3): MULTITENANT_DB=true + TENANT_RESOLUTION=domain
# Tokens webhook por tenant (seed dev — produção vai no mestre):
# ASAAS_WEBHOOK_TOKEN=bmc-webhook-token-minimum-32-characters-long
# DEMO_ASAAS_WEBHOOK_TOKEN=demo-webhook-token-minimum-32-characters-long

# Primeiro admin (após migration de usuarios):
# php database/seeds/criar_admin.php "admin@exemplo.com" "SenhaForte123"

# Tabela login_attempts (rate limit do login):
# php migrate.php run

# Testes PHPUnit com MySQL real (opcional):
# ERP_RUN_INTEGRATION=1 vendor/bin/phpunit

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Security
APP_KEY=
CSRF_TOKEN_LENGTH=32
SESSION_TIMEOUT=1800

# Features
ENABLE_AUDIT=true
ENABLE_SOFT_DELETES=true
ENABLE_ROLE_BASED_ACCESS=true

# Mail (Mailtrap Sandbox para desenvolvimento; Mailtrap Sending ou SMTP real em produção)
MAIL_DRIVER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Nome da Loja"
MAIL_ENCRYPTION=tls
MAIL_ENABLED=false
MAIL_ADMIN_TO=admin@example.com

# Cache (Optional - future use)
CACHE_DRIVER=file

# Asaas — Gateway Pix (sandbox: https://api-sandbox.asaas.com/v3)
ASAAS_ENABLED=false
ASAAS_SANDBOX=true
ASAAS_API_KEY=
# Token definido no painel Asaas > Integrações > Webhooks (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
ASAAS_PIX_DUE_DAYS=3
ASAAS_USER_AGENT=ErpCommerce/1.0

# Cartão de crédito (fatura hospedada Asaas — o site nunca recebe dados do cartão)
# Requer ASAAS_ENABLED=true e cartão habilitado na conta Asaas.
PAYMENT_CARD_ENABLED=true
PAYMENT_CARD_MAX_INSTALLMENTS=6
# Valor mínimo de cada parcela (R$)
PAYMENT_CARD_MIN_INSTALLMENT=50
