{
    "name": "erp-produto/core",
    "description": "Produto ERP reutilizavel para gestao operacional",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "league/container": "^4.2",
        "phpmailer/phpmailer": "6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Erp\\": "app/Erp/",
            "Clients\\": "app/Clients/",
            "Shared\\": "app/Shared/",
            "Core\\": "core/",
            "Database\\Migrations\\": "database/migrations/",
            "Database\\": "database/"
        },
        "files": [
            "app/Helpers/functions.php",
            "app/Helpers/view.php",
            "app/Helpers/debug.php",
            "app/Helpers/formatting.php",
            "app/Services/functions/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
